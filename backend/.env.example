# =====================================================
# BACKEND CONFIGURATION (.env.example)
# =====================================================
# Copy to .env and preencha com os valores reais

# ===== SUPABASE =====
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ===== TRADING 212 API =====
T212_API_KEY=your-api-key
T212_API_SECRET=your-api-secret
T212_ENVIRONMENT=demo  # 'demo' ou 'live' — fonte única de verdade (Item #15), não editável na UI

# ===== DEPLOY TRACKING (Item #15) =====
# NÃO definir manualmente — o Render preenche isto sozinho em cada deploy.
# Usado para detetar código novo e desligar a automação por segurança.
# RENDER_GIT_COMMIT=

# ===== FASTAPI =====
FASTAPI_ENV=development  # 'development' ou 'production'
FASTAPI_DEBUG=True
FASTAPI_PORT=8000
FASTAPI_HOST=0.0.0.0

# ===== JWT =====
# Gera um segredo forte: python -c "import secrets; print(secrets.token_urlsafe(64))"
# NUNCA usar um valor previsível ou documentado — quem o souber forja logins válidos.
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=30

# ===== LOGIN SECURITY (Item #12) =====
LOGIN_DELAY_MAX_MINUTES=15   # Teto do atraso progressivo por IP (1-60)
TRUSTED_DEVICE_DAYS=30       # Duração do "trusted device" (0-90, 0=pedir MFA sempre)
LOGIN_ALERT_THRESHOLD=5      # Falhas consecutivas antes de alertar por email
COOKIE_SECURE=True           # False só em dev local (http://localhost)
FRONTEND_URL=http://localhost:5173  # URL do frontend, para CORS com credentials

# ===== EMAIL ALERTS (opcional — sem isto, alertas caem em log) =====
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ===== DATABASE =====
DATABASE_URL=postgresql://user:password@localhost:5432/trading212

# ===== ENCRYPTION =====
ENCRYPTION_KEY=your-fernet-key  # Gera com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ===== LOGGING =====
LOG_LEVEL=INFO

# ===== SCHEDULER =====
SCHEDULER_CHECK_INTERVAL=300  # Segundos (5 minutos)
